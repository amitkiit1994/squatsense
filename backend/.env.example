# SquatSense / FreeForm Fitness — Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/squatsense

# ── JWT / Auth (REQUIRED — at least 32 chars) ────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# ── CORS (JSON array or comma-separated) ─────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend URLs (for email links in password reset, verification) ──────
FRONTEND_URL=http://localhost:3000
SQUATSENSE_URL=http://localhost:3001

# ── Registration allowlist (comma-separated emails; empty = open) ────────
ALLOWED_EMAILS=

# ── AI Coach (optional — disabled by default) ────────────────────────────
AI_COACH_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Email via Resend (optional — emails fail silently without key) ───────
RESEND_API_KEY=

# ── Observability (optional — Sentry error tracking) ─────────────────────
SENTRY_DSN=
