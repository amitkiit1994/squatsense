FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libegl1 libgles2 curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt && \
    pip install --no-cache-dir --force-reinstall --no-deps opencv-python-headless>=4.8.0

COPY backend/ ./backend/
COPY alembic.ini .

ENV PYTHONPATH=/app

# Build-time import smoke test: import the app exactly as gunicorn does at
# boot (backend.main:app) so the image build fails on import-time crashes
# (e.g. Pydantic settings/validator errors) instead of crash-looping in prod.
# JWT_SECRET_KEY is the only required-no-default setting; the dummy value
# satisfies its >=32 char validator. All other settings have safe defaults.
RUN JWT_SECRET_KEY=build-smoke-test-dummy-key-32chars-x python -c "from backend.main import app"

ENV PORT=8000
EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT}/api/v1/health || exit 1

# Single worker required: kiosk queue state lives in process memory.
# Multiple workers would cause queue entries to be invisible across workers.
CMD alembic upgrade head && gunicorn backend.main:app -k uvicorn.workers.UvicornWorker -w 1 --bind 0.0.0.0:${PORT} --timeout 120
